<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ViVaKR.AuthLibrary</PackageId>
    <Version>1.0.1</Version>
    <Authors>ViVaKR</Authors>
    <Description>JWT authentication library</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ViVaKR/authentication.jwt</RepositoryUrl>
    <PackageTags>jwt;authentication;aspnetcore;identity;entity</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.13" />
  </ItemGroup>

</Project>
